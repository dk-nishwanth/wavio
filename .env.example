# Session signing secret (any long random string)
APP_SECRET=change-me   # use 32+ random characters in production
# Where the SQLite file lives
DATABASE_PATH=./data/app.db
# Public base URL (used for webhook URL shown in Settings)
APP_URL=http://localhost:3000
# Secret protecting /api/cron/tick when called by a scheduler
CRON_SECRET=change-me

# --- production (all required unless noted) ---
# ENCRYPTION_KEY=           # optional; defaults to APP_SECRET
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# MEDIA_DIR=
# ENFORCE_PLANS=1        # off by default: every feature is available. Set to 1 to enforce plan limits.
