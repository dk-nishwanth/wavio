# Copy to .env.production — never commit the real file.
NODE_ENV=production
APP_URL=https://bot.yourresort.com
APP_SECRET=           # openssl rand -base64 36
ENCRYPTION_KEY=       # openssl rand -base64 36  (keep a copy somewhere safe: without it saved tokens can't be read)
CRON_SECRET=          # openssl rand -base64 24
TZ=Asia/Kolkata       # reminders and "team online" hours follow this clock
# Optional
# ANTHROPIC_API_KEY=  # only if you switch the bot to AI mode
# AUTO_BACKUP=1
